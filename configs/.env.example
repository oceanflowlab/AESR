# Copy to .env locally and load it in your shell. Do not commit .env.

# Seedance / Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# Multimodal prompt enhancement and critique
YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai/v1
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-pro-preview
QWEN_MODEL_NAME=qwen3.5-397b-a17b
ACE_QWEN_BACKEND=gemini
ACE_GEMINI_TRANSPORT=yunwu

# Image editing for repaired keyframes
YUNWU_GPT_IMAGE_API_KEY=
YUNWU_GPT_IMAGE_BASE_URL=https://yunwu.ai/v1
GPT_IMAGE_MODEL=gpt-image-2

# Optional DashScope backend
DASHSCOPE_API_KEY=

# Runtime tuning
CRITIQUE_FRAME_SCREENSHOTS=24
EDIT_PROMPT_FRAME_SCREENSHOTS=24
MISSING_VISUAL_CANDIDATE_FRAMES=8

# Optional local paths for the complete evaluation workflow. These paths and
# model weights are intentionally not included in this repository.
EVAL_CONSISID_ROOT=
EVAL_VBENCH_ROOT=
EVAL_MSVBENCH_ROOT=
EVAL_KALM_MODEL_PATH=
EVAL_GME_MODEL_PATH=
EVAL_GME_LOCAL_FILES_ONLY=0
